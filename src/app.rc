#include "resource.h"
#include "version.h"
#include <winver.h>

// The version stamped on the exe (Explorer's Details tab; and read by a newer copy,
// which takes over from an older one already running -- main.cpp).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SRLOOM_VERSION_MAJOR, SRLOOM_VERSION_MINOR, SRLOOM_VERSION_PATCH, 0
 PRODUCTVERSION SRLOOM_VERSION_MAJOR, SRLOOM_VERSION_MINOR, SRLOOM_VERSION_PATCH, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName",      "Stereopticon"
            VALUE "FileDescription",  "Stereo Loom"
            VALUE "FileVersion",      SRLOOM_VERSION_STR
            VALUE "InternalName",     "StereoLoom"
            VALUE "OriginalFilename", "StereoLoom.exe"
            VALUE "ProductName",      "Stereo Loom"
            VALUE "ProductVersion",   SRLOOM_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END

// Application icon: Stereo Loom's logo (the Stereopticon logo set), the dark tile.
IDI_TRAY            ICON "../assets/stereo_loom.ico"
// The light tile, carried too (for shortcuts / anything that wants the light one).
IDI_APP_LIGHT       ICON "../assets/stereo_loom_light.ico"
// The tray's: the mark alone, no tile -- light threads for a dark taskbar, dark
// threads for a light one (TrayIcon.cpp follows Windows' setting).
IDI_TRAY_ON_DARK    ICON "../assets/tray_on_dark.ico"
IDI_TRAY_ON_LIGHT   ICON "../assets/tray_on_light.ico"

// UI fonts embedded into the exe (Inter, SIL Open Font License) — loaded from these
// resources at runtime so no font files need to ship beside the executable.
IDR_FONT_REGULAR  RCDATA "../assets/fonts/Inter-Regular.ttf"
IDR_FONT_SEMIBOLD RCDATA "../assets/fonts/Inter-SemiBold.ttf"

// NPClient.dll (x64) — TrackIR consumer DLL games load to receive head pose.
// Built by CMake from third_party/npclient/npclient.c (MIT, OpenTrack contrib)
// and copied here by the NPClient64 POST_BUILD step. Extracted on first launch
// to %LOCALAPPDATA%\SRLoom\NPClient\NPClient64.dll.
IDR_NPCLIENT64    RCDATA "../assets/npclient/NPClient64.dll"
